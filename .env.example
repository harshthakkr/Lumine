# Postgres connection string.
# Local:  postgres://<user>@localhost:5432/lumine
# Neon:   use the *pooled* connection string (host contains "-pooler"), with ?sslmode=require
DATABASE_URL=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of the app (http://localhost:3000 locally, https://<domain> in production)
BETTER_AUTH_URL=http://localhost:3000

# Protects /api/cron/cleanup-demo. Vercel sends it automatically to cron jobs.
CRON_SECRET=
